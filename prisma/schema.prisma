generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  telegramId    String?
  openaiApiKey  String?
  plan          String?   @default("free")
  subscriptionExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  agents        Agent[]
  policies      Policy[]
  wallets       Wallet[]
  demoTransactions DemoTransaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
}

// App models
enum AgentType {
  INVESTOR
  TRADER
}

model Agent {
  id                String   @id @default(cuid())
  userId            String
  name              String
  description       String?
  agentType         AgentType @default(INVESTOR)
  isActive          Boolean  @default(true)
  walletId          String?
  walletAddress     String?
  demoBalance       Float?
  initialDemoBalance Float?
  run24_7           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  policies Policy[]
  demoTransactions DemoTransaction[]
}

model Policy {
  id                 String   @id @default(cuid())
  userId             String
  agentId            String
  name               String   @default("Default Policy")
  dailyLimit         Float    @default(0)
  weeklyLimit        Float    @default(0)
  maxPerTransaction  Float    @default(0)
  allowedOperations  String[] @default(["transfer"])
  timeRestrictions    Json?
  notifications      Json?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String
  agentId     String?
  address     String
  networkId   String   @default("base-sepolia")
  cdpWalletId String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
}

model DemoTransaction {
  id            String   @id @default(cuid())
  agentId       String
  userId        String
  type          String
  amountEth     Float
  reason        String
  marketPriceUsd Float?
  asset         String?
  priceReason   String?
  termDays      Int?
  termMinutes   Int?
  plans         String?
  assetPriceUsd Float?
  createdAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}
